NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_URL=https://uteq-seguridad.up.railway.app

# Chatbot de reportes (Google AI Studio — cuota gratis)
GEMINI_API_KEY=
# Si gemini-flash-latest da 503 (alta demanda), usa 2.0-flash
GEMINI_MODEL=gemini-2.0-flash
# Opcional: modelos extra separados por coma
# GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-1.5-flash

# Clave compartida ESP32 → POST /api/sos/device (header X-Hermes-Device-Key)
# En producción Railway debe coincidir con SOS_KEY del firmware ESP32
WEARABLE_SOS_KEY=hermes-sos-prod

# WhatsApp SOS (Meta Cloud API)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=hermes_sos_alerta
WHATSAPP_TEMPLATE_LANG=en
